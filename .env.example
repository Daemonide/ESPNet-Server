# HTTP + WebSocket (dashboard, REST API)
PORT=8880

# UDP (ESP32 fleet)
UDP_PORT=8888
ESP_PORT=8889

# Game tuning
KICKER_COOLDOWN_MS=15000
EMP_DURATION_MS=3000
MATCH_DURATION_MS=900000
INTENSE_THRESHOLD_MS=45000
OFFLINE_THRESHOLD_MS=6000
DISCOVERY_BROADCAST_INTERVAL_MS=2000

# Spotify Web API (optional — leave blank to run on the built-in Web Audio synth only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8880/auth/spotify/callback
